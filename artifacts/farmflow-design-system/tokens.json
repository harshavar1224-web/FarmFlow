{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Design tokens in the W3C Design Tokens (DTCG) format. THIS FILE IS THE SINGLE SOURCE OF TRUTH for the design system. Edit values here only -- do not hand-edit the generated src/index.css or src/generated/tokens.ts. The dev server regenerates them on every change (scripts/build-tokens.mjs, wired through vite.config.ts). Colors are authored as hex; the generator converts them to `H S% L%` channels for the web theme and keeps hex for mobile (tokens.ts). Every color role exists in both light and dark.",
  "color": {
    "$type": "color",
    "light": {
      "background": { "$value": "#f7f7f0", "$description": "Soft warm ivory keeps the product calm without becoming colorless." },
      "foreground": { "$value": "#1b2b21" },
      "border": { "$value": "#dce5dc" },
      "card": { "$value": "#fffefa" },
      "cardForeground": { "$value": "#1b2b21" },
      "popover": { "$value": "#fffefa" },
      "popoverForeground": { "$value": "#1b2b21" },
      "primary": {
        "$value": "#145c3e",
        "$description": "Deep forest green for primary actions, links, and essential emphasis."
      },
      "primaryForeground": { "$value": "#ffffff" },
      "secondary": { "$value": "#e6efe7" },
      "secondaryForeground": { "$value": "#174630" },
      "muted": { "$value": "#eef2ec" },
      "mutedForeground": { "$value": "#53665a" },
      "accent": { "$value": "#f3ead2", "$description": "Muted harvest gold is reserved for highlights, not routine actions." },
      "accentForeground": { "$value": "#594317" },
      "destructive": { "$value": "#a83e36" },
      "destructiveForeground": { "$value": "#ffffff" },
      "input": { "$value": "#d4dfd5" },
      "ring": { "$value": "#2f8c5e" },
      "chart1": { "$value": "#187a50" },
      "chart2": { "$value": "#be8d37" },
      "chart3": { "$value": "#c96448" },
      "chart4": { "$value": "#557f8e" },
      "chart5": { "$value": "#89994b" },
      "sidebar": { "$value": "#153f30" },
      "sidebarForeground": { "$value": "#f0f4eb" },
      "sidebarBorder": { "$value": "#2a5742" },
      "sidebarPrimary": { "$value": "#b9dca6" },
      "sidebarPrimaryForeground": { "$value": "#153f30" },
      "sidebarAccent": { "$value": "#245441" },
      "sidebarAccentForeground": { "$value": "#f0f4eb" },
      "sidebarRing": { "$value": "#c4db9e" }
    },
    "dark": {
      "background": { "$value": "#121b15" },
      "foreground": { "$value": "#ecf1e8" },
      "border": { "$value": "#324138" },
      "card": { "$value": "#19251d" },
      "cardForeground": { "$value": "#ecf1e8" },
      "popover": { "$value": "#202d24" },
      "popoverForeground": { "$value": "#f1f4ed" },
      "primary": { "$value": "#57c384" },
      "primaryForeground": { "$value": "#082e1d" },
      "secondary": { "$value": "#28392e" },
      "secondaryForeground": { "$value": "#dfebe0" },
      "muted": { "$value": "#1e2a22" },
      "mutedForeground": { "$value": "#aab9ac" },
      "accent": { "$value": "#40371f" },
      "accentForeground": { "$value": "#f0d993" },
      "destructive": { "$value": "#702e2c" },
      "destructiveForeground": { "$value": "#ffece9" },
      "input": { "$value": "#37463b" },
      "ring": { "$value": "#72d3a0" },
      "chart1": { "$value": "#53c28a" },
      "chart2": { "$value": "#e0b755" },
      "chart3": { "$value": "#e18463" },
      "chart4": { "$value": "#83b4c2" },
      "chart5": { "$value": "#b7c66a" },
      "sidebar": { "$value": "#101a14" },
      "sidebarForeground": { "$value": "#eaf0e7" },
      "sidebarBorder": { "$value": "#2c3b30" },
      "sidebarPrimary": { "$value": "#347b55" },
      "sidebarPrimaryForeground": { "$value": "#ffffff" },
      "sidebarAccent": { "$value": "#203127" },
      "sidebarAccentForeground": { "$value": "#eaf0e7" },
      "sidebarRing": { "$value": "#72d3a0" }
    }
  },
  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "sans": {
        "$value": ["Manrope", "sans-serif"],
        "$description": "Modern, friendly sans-serif for product interfaces and body copy."
      },
      "serif": { "$value": ["Georgia", "serif"] },
      "mono": { "$value": ["Menlo", "monospace"] }
    }
  },
  "radius": {
    "$type": "dimension",
    "base": {
      "$value": "1rem",
      "$description": "Generous 16px base radius; component radius steps derive from this."
    }
  },
  "spacing": {
    "$type": "dimension",
    "base": {
      "$value": "0.25rem",
      "$description": "Base spacing step components multiply."
    }
  }
}
